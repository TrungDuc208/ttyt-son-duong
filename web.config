<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bản tối giản đang chạy ổn trên hosting VDC (Plesk/IIS): chỉ đặt index.html
  làm trang mặc định. Các mục nâng cao (nén/cache/security headers/rewrite)
  đã gây lỗi 500 trên hosting này nên tạm bỏ. Ép HTTPS dùng nút trong Plesk
  (Hosting Settings -> Permanent 301 redirect HTTP->HTTPS).
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Cho phép tải file cài đặt ứng dụng Android (.apk) — IIS mặc định không phục vụ đuôi này.
         Dùng <remove> trước <mimeMap> để tránh lỗi trùng khai báo nếu máy chủ đã định nghĩa sẵn. -->
    <staticContent>
      <remove fileExtension=".apk" />
      <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
    </staticContent>
  </system.webServer>
</configuration>
