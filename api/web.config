<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bảo vệ thư mục /api trên IIS:
  - Chặn tải trực tiếp config.php, schema.sql, *.log (lộ mật khẩu CSDL).
  - Không cho liệt kê thư mục.
-->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="config.php" />
          <add segment="config.example.php" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
